{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:zeus17:rm:engine-inputs:v1",
 "title": "RM engine inputs (strictly typed; no unresolved state)",
 "x-enums-source": "../rm-tool-v1.html (regenerated by build_schemas.py; verified by check_schemas.py)",
 "$defs": {
  "release_hint": {
   "type": "object",
   "required": [
    "name",
    "notes",
    "deliveryModels"
   ],
   "additionalProperties": false,
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1,
     "description": "Release name (the text the keyword rules scan, with notes)."
    },
    "notes": {
     "type": "string",
     "description": "Release notes text. May be an empty string if the user confirmed there are none."
    },
    "deliveryModels": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "enum": [
       "cloud",
       "api",
       "mobile",
       "desktop",
       "legacy",
       "di2",
       "cwa",
       "pilot"
      ]
     },
     "description": "4 or more delivery models trigger the complexity hint before any keyword rule."
    }
   }
  },
  "defect_hint": {
   "type": "object",
   "required": [
    "title"
   ],
   "additionalProperties": false,
   "properties": {
    "title": {
     "type": "string",
     "minLength": 8,
     "description": "Defect title. The engine shows nothing for titles shorter than 8 characters."
    }
   }
  },
  "readiness": {
   "type": "object",
   "required": [
    "gates",
    "defects",
    "envPath",
    "environments"
   ],
   "additionalProperties": false,
   "properties": {
    "gates": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "id",
       "status",
       "signedBy"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "enum": [
         "dev-complete",
         "code-review",
         "sit",
         "uat",
         "preprod",
         "gng",
         "deploy",
         "hypercare"
        ]
       },
       "status": {
        "enum": [
         "not-started",
         "pending",
         "in-progress",
         "passed",
         "failed",
         "waived"
        ]
       },
       "signedBy": {
        "type": "string"
       }
      }
     }
    },
    "defects": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "releaseId",
       "classification"
      ],
      "additionalProperties": false,
      "properties": {
       "releaseId": {
        "type": "string",
        "minLength": 1
       },
       "classification": {
        "enum": [
         "blocker",
         "deferred",
         "known",
         "wontfix"
        ]
       },
       "status": {
        "enum": [
         "open",
         "fix_identified",
         "fix_in_progress",
         "blocked",
         "fixed_unverified",
         "reopened",
         "resolved_confirmed",
         "deferred",
         "accepted",
         "wont_fix",
         "duplicate",
         "cannot_reproduce",
         "not_a_defect"
        ],
        "description": "Lifecycle status (R-1). Absent means Open. A blocker counts only while unresolved: Open / Fix identified / Fix in progress / Blocked / Fixed - awaiting verification / Reopened, or Resolved without a named confirmer, or closed without a named decision-maker and reason."
       },
       "decisionRecorded": {
        "type": "boolean",
        "description": "True only if a named decision-maker AND a reason are recorded (needed for Deferred, Accepted, Won't fix, Duplicate, Cannot reproduce, Not a defect to stop a blocker counting)."
       },
       "confirmationRecorded": {
        "type": "boolean",
        "description": "True only if a named confirmer is recorded (needed for Resolved & confirmed to stop a blocker counting)."
       }
      }
     },
     "description": "Defects for THIS release. A defect counts as an open blocker per the tool's isUnresolvedBlocker(): classification === 'blocker' AND not (resolved with a named confirmer, or closed with a named decision-maker and reason)."
    },
    "envPath": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "enum": [
       "DEV",
       "SIT",
       "UAT",
       "PRE-PROD",
       "PROD"
      ]
     }
    },
    "environments": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "env",
       "health"
      ],
      "additionalProperties": false,
      "properties": {
       "env": {
        "enum": [
         "DEV",
         "SIT",
         "UAT",
         "PRE-PROD",
         "PROD"
        ]
       },
       "health": {
        "enum": [
         "unknown",
         "healthy",
         "warning",
         "blocked"
        ]
       }
      }
     }
    }
   }
  },
  "gate_hint": {
   "type": "object",
   "required": [
    "gateId",
    "entryConfirmed",
    "exitConfirmed",
    "blockerCount",
    "preProdVersion",
    "prodVersion",
    "deliveryModels"
   ],
   "additionalProperties": false,
   "properties": {
    "gateId": {
     "enum": [
      "dev-complete",
      "code-review",
      "sit",
      "uat",
      "preprod",
      "gng",
      "deploy",
      "hypercare"
     ]
    },
    "entryConfirmed": {
     "type": "integer",
     "minimum": 0
    },
    "exitConfirmed": {
     "type": "integer",
     "minimum": 0
    },
    "blockerCount": {
     "type": "integer",
     "minimum": 0
    },
    "preProdVersion": {
     "type": "string"
    },
    "prodVersion": {
     "type": "string"
    },
    "deliveryModels": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "enum": [
       "cloud",
       "api",
       "mobile",
       "desktop",
       "legacy",
       "di2",
       "cwa",
       "pilot"
      ]
     }
    }
   }
  },
  "risk_score": {
   "type": "object",
   "required": [
    "likelihood",
    "impact"
   ],
   "additionalProperties": false,
   "properties": {
    "likelihood": {
     "type": "integer",
     "minimum": 1,
     "maximum": 5
    },
    "impact": {
     "type": "integer",
     "minimum": 1,
     "maximum": 5
    }
   }
  },
  "decision_record": {
   "type": "object",
   "required": [
    "decision",
    "decidedBy",
    "rationale",
    "riskNotes"
   ],
   "additionalProperties": false,
   "properties": {
    "decision": {
     "enum": [
      "go",
      "nogo"
     ]
    },
    "decidedBy": {
     "type": "string",
     "minLength": 1
    },
    "rationale": {
     "type": "string"
    },
    "riskNotes": {
     "type": "string"
    }
   }
  }
 }
}
