{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:zeus17:rm:engine-outputs:v1",
 "title": "RM engine results (computed | cannot_be_determined | not_assessed)",
 "$defs": {
  "Provenance": {
   "enum": [
    "form",
    "user_confirmed"
   ]
  },
  "UnresolvedReason": {
   "enum": [
    "declined",
    "unknown_to_user",
    "not_yet_asked"
   ]
  },
  "Unresolved": {
   "type": "object",
   "required": [
    "state",
    "reason"
   ],
   "properties": {
    "state": {
     "const": "unresolved"
    },
    "reason": {
     "$ref": "#/$defs/UnresolvedReason"
    }
   },
   "additionalProperties": false
  },
  "Caveat": {
   "type": "object",
   "required": [
    "code",
    "field"
   ],
   "properties": {
    "code": {
     "type": "string",
     "minLength": 1
    },
    "field": {
     "type": "string",
     "minLength": 1
    }
   },
   "additionalProperties": false
  },
  "MissingInput": {
   "type": "object",
   "required": [
    "field",
    "reason_code"
   ],
   "properties": {
    "field": {
     "type": "string",
     "minLength": 1
    },
    "reason_code": {
     "type": "string",
     "minLength": 1
    }
   },
   "additionalProperties": false
  },
  "release_hint": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "engine",
      "status",
      "output",
      "caveats"
     ],
     "properties": {
      "engine": {
       "const": "release_hint"
      },
      "status": {
       "const": "computed"
      },
      "output": {
       "type": "object",
       "required": [
        "matched",
        "complete"
       ],
       "additionalProperties": false,
       "properties": {
        "matched": {
         "type": "boolean"
        },
        "rule": {
         "enum": [
          "dm_complexity",
          "release_rule_0",
          "release_rule_1",
          "release_rule_2",
          "release_rule_3",
          "release_rule_4",
          "release_rule_5",
          "release_rule_6",
          "release_rule_7",
          "release_rule_8"
         ],
         "description": "dm_complexity = the >=4 delivery-model pre-check; release_rule_0 = payment ... release_rule_8 = decommission. First match wins."
        },
        "level": {
         "enum": [
          "danger",
          "warn",
          "info"
         ]
        },
        "hint_html": {
         "type": "string",
         "description": "Verbatim engine text. Never reworded."
        },
        "matched_text": {
         "type": "string",
         "description": "The words in the text that triggered the rule (Q-5). Display aid: a hint is a keyword match, not an assessment."
        },
        "complete": {
         "type": "boolean",
         "description": "False whenever a fallback or skipped check means 'nothing found' must NOT be read as 'all clear'."
        }
       }
      },
      "caveats": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/Caveat"
       }
      }
     },
     "additionalProperties": false,
     "if": {
      "required": [
       "caveats"
      ],
      "properties": {
       "caveats": {
        "minItems": 1
       }
      }
     },
     "then": {
      "properties": {
       "output": {
        "properties": {
         "complete": {
          "const": false
         }
        }
       }
      }
     }
    },
    {
     "type": "object",
     "required": [
      "engine",
      "status",
      "missing"
     ],
     "properties": {
      "engine": {
       "const": "release_hint"
      },
      "status": {
       "const": "cannot_be_determined"
      },
      "missing": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/MissingInput"
       }
      }
     },
     "additionalProperties": false
    },
    {
     "type": "object",
     "required": [
      "engine",
      "status",
      "missing"
     ],
     "properties": {
      "engine": {
       "const": "release_hint"
      },
      "status": {
       "const": "not_assessed"
      },
      "missing": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/MissingInput"
       }
      }
     },
     "additionalProperties": false
    }
   ]
  },
  "defect_hint": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "engine",
      "status",
      "output",
      "caveats"
     ],
     "properties": {
      "engine": {
       "const": "defect_hint"
      },
      "status": {
       "const": "computed"
      },
      "output": {
       "type": "object",
       "required": [
        "matched"
       ],
       "additionalProperties": false,
       "properties": {
        "matched": {
         "type": "boolean"
        },
        "rule": {
         "enum": [
          "defect_rule_0",
          "defect_rule_1",
          "defect_rule_2",
          "defect_rule_3",
          "defect_rule_4",
          "defect_rule_5",
          "defect_rule_6",
          "defect_rule_7"
         ]
        },
        "suggested_severity": {
         "type": "string",
         "description": "Engine-suggested severity KEY. Only meaningful if the organisation's severity scale contains it."
        },
        "suggested_classification": {
         "enum": [
          "blocker",
          "deferred",
          "known",
          "wontfix"
         ]
        },
        "hint_html": {
         "type": "string"
        },
        "matched_text": {
         "type": "string",
         "description": "The words in the title that triggered the rule (Q-5)."
        }
       }
      },
      "caveats": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/Caveat"
       }
      }
     },
     "additionalProperties": false
    },
    {
     "type": "object",
     "required": [
      "engine",
      "status",
      "missing"
     ],
     "properties": {
      "engine": {
       "const": "defect_hint"
      },
      "status": {
       "const": "cannot_be_determined"
      },
      "missing": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/MissingInput"
       }
      }
     },
     "additionalProperties": false
    },
    {
     "type": "object",
     "required": [
      "engine",
      "status",
      "missing"
     ],
     "properties": {
      "engine": {
       "const": "defect_hint"
      },
      "status": {
       "const": "not_assessed"
      },
      "missing": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/MissingInput"
       }
      }
     },
     "additionalProperties": false
    }
   ]
  },
  "readiness": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "engine",
      "status",
      "output",
      "caveats"
     ],
     "properties": {
      "engine": {
       "const": "readiness"
      },
      "status": {
       "const": "computed"
      },
      "output": {
       "type": "object",
       "required": [
        "score",
        "gates",
        "defects",
        "envs",
        "signoffs"
       ],
       "additionalProperties": false,
       "properties": {
        "score": {
         "type": "integer",
         "minimum": 0,
         "maximum": 100
        },
        "gates": {
         "type": "integer",
         "minimum": 0,
         "maximum": 100
        },
        "defects": {
         "type": "integer",
         "minimum": 0,
         "maximum": 100
        },
        "envs": {
         "type": "integer",
         "minimum": 0,
         "maximum": 100
        },
        "signoffs": {
         "type": "integer",
         "minimum": 0,
         "maximum": 100
        }
       }
      },
      "caveats": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/Caveat"
       }
      }
     },
     "additionalProperties": false
    },
    {
     "type": "object",
     "required": [
      "engine",
      "status",
      "missing"
     ],
     "properties": {
      "engine": {
       "const": "readiness"
      },
      "status": {
       "const": "cannot_be_determined"
      },
      "missing": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/MissingInput"
       }
      }
     },
     "additionalProperties": false
    },
    {
     "type": "object",
     "required": [
      "engine",
      "status",
      "missing"
     ],
     "properties": {
      "engine": {
       "const": "readiness"
      },
      "status": {
       "const": "not_assessed"
      },
      "missing": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/MissingInput"
       }
      }
     },
     "additionalProperties": false
    }
   ]
  },
  "gate_hint": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "engine",
      "status",
      "output",
      "caveats"
     ],
     "properties": {
      "engine": {
       "const": "gate_hint"
      },
      "status": {
       "const": "computed"
      },
      "output": {
       "type": "object",
       "required": [
        "hints",
        "complete"
       ],
       "additionalProperties": false,
       "properties": {
        "hints": {
         "type": "array",
         "items": {
          "type": "object",
          "required": [
           "kind",
           "text_html"
          ],
          "additionalProperties": false,
          "properties": {
           "kind": {
            "enum": [
             "blockers_open",
             "entry_unconfirmed",
             "exit_unconfirmed",
             "version_mismatch",
             "mobile_store_approval"
            ]
           },
           "text_html": {
            "type": "string"
           }
          }
         }
        },
        "complete": {
         "type": "boolean",
         "description": "False whenever a fallback or skipped check means 'nothing found' must NOT be read as 'all clear'."
        }
       }
      },
      "caveats": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/Caveat"
       }
      }
     },
     "additionalProperties": false,
     "if": {
      "required": [
       "caveats"
      ],
      "properties": {
       "caveats": {
        "minItems": 1
       }
      }
     },
     "then": {
      "properties": {
       "output": {
        "properties": {
         "complete": {
          "const": false
         }
        }
       }
      }
     }
    },
    {
     "type": "object",
     "required": [
      "engine",
      "status",
      "missing"
     ],
     "properties": {
      "engine": {
       "const": "gate_hint"
      },
      "status": {
       "const": "cannot_be_determined"
      },
      "missing": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/MissingInput"
       }
      }
     },
     "additionalProperties": false
    },
    {
     "type": "object",
     "required": [
      "engine",
      "status",
      "missing"
     ],
     "properties": {
      "engine": {
       "const": "gate_hint"
      },
      "status": {
       "const": "not_assessed"
      },
      "missing": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/MissingInput"
       }
      }
     },
     "additionalProperties": false
    }
   ]
  },
  "risk_score": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "engine",
      "status",
      "output",
      "caveats"
     ],
     "properties": {
      "engine": {
       "const": "risk_score"
      },
      "status": {
       "const": "computed"
      },
      "output": {
       "type": "object",
       "required": [
        "score",
        "band"
       ],
       "additionalProperties": false,
       "properties": {
        "score": {
         "type": "integer",
         "minimum": 1,
         "maximum": 25
        },
        "band": {
         "enum": [
          "high",
          "medium",
          "low"
         ]
        }
       }
      },
      "caveats": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/Caveat"
       }
      }
     },
     "additionalProperties": false
    },
    {
     "type": "object",
     "required": [
      "engine",
      "status",
      "missing"
     ],
     "properties": {
      "engine": {
       "const": "risk_score"
      },
      "status": {
       "const": "cannot_be_determined"
      },
      "missing": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/MissingInput"
       }
      }
     },
     "additionalProperties": false
    },
    {
     "type": "object",
     "required": [
      "engine",
      "status",
      "missing"
     ],
     "properties": {
      "engine": {
       "const": "risk_score"
      },
      "status": {
       "const": "not_assessed"
      },
      "missing": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/MissingInput"
       }
      }
     },
     "additionalProperties": false
    }
   ]
  },
  "decision_record": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "engine",
      "status",
      "output",
      "caveats"
     ],
     "properties": {
      "engine": {
       "const": "decision_record"
      },
      "status": {
       "const": "computed"
      },
      "output": {
       "type": "object",
       "required": [
        "recorded"
       ],
       "additionalProperties": false,
       "properties": {
        "recorded": {
         "const": true
        },
        "decision": {
         "enum": [
          "go",
          "nogo"
         ]
        }
       }
      },
      "caveats": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/Caveat"
       }
      }
     },
     "additionalProperties": false
    },
    {
     "type": "object",
     "required": [
      "engine",
      "status",
      "missing"
     ],
     "properties": {
      "engine": {
       "const": "decision_record"
      },
      "status": {
       "const": "cannot_be_determined"
      },
      "missing": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/MissingInput"
       }
      }
     },
     "additionalProperties": false
    },
    {
     "type": "object",
     "required": [
      "engine",
      "status",
      "missing"
     ],
     "properties": {
      "engine": {
       "const": "decision_record"
      },
      "status": {
       "const": "not_assessed"
      },
      "missing": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/MissingInput"
       }
      }
     },
     "additionalProperties": false
    }
   ]
  }
 }
}
